{
    "definition": {
        "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
        "contentVersion": "1.0.0.0",
        "triggers": {
            "Microsoft_Sentinel_incident": {
                "type": "ApiConnectionWebhook",
                "inputs": {
                    "host": {
                        "connection": {
                            "name": "@parameters('$connections')['azuresentinel-1']['connectionId']"
                        }
                    },
                    "body": {
                        "callback_url": "@listCallbackUrl()"
                    },
                    "path": "/incident-creation"
                }
            }
        },
        "actions": {
            "Initialize_SummaryTable": {
                "runAfter": {},
                "type": "InitializeVariable",
                "inputs": {
                    "variables": [
                        {
                            "name": "SummaryTable",
                            "type": "string",
                            "value": "<tr><th style=\"padding:8px;border:1px solid #ccc;background:#f2f2f2;\">User</th><th style=\"padding:8px;border:1px solid #ccc;background:#f2f2f2;\">Account Status</th><th style=\"padding:8px;border:1px solid #ccc;background:#f2f2f2;\">Password Reset</th><th style=\"padding:8px;border:1px solid #ccc;background:#f2f2f2;\">MFA Group</th><th style=\"padding:8px;border:1px solid #ccc;background:#f2f2f2;\">Notes</th></tr>"
                        }
                    ]
                }
            },
            "Initialize_EmailSummaryTable": {
                "runAfter": {
                    "Initialize_SummaryTable": [
                        "Succeeded"
                    ]
                },
                "type": "InitializeVariable",
                "inputs": {
                    "variables": [
                        {
                            "name": "EmailSummaryTable",
                            "type": "string",
                            "value": "<tr><th style=\"padding:8px;border:1px solid #ccc;background:#f2f2f2;\">User</th><th style=\"padding:8px;border:1px solid #ccc;background:#f2f2f2;\">Account Status</th><th style=\"padding:8px;border:1px solid #ccc;background:#f2f2f2;\">Password Reset</th><th style=\"padding:8px;border:1px solid #ccc;background:#f2f2f2;\">MFA Group</th><th style=\"padding:8px;border:1px solid #ccc;background:#f2f2f2;\">Notes</th></tr>"
                        }
                    ]
                }
            },
            "Initialize_ErrorLog": {
                "runAfter": {
                    "Initialize_EmailSummaryTable": [
                        "Succeeded"
                    ]
                },
                "type": "InitializeVariable",
                "inputs": {
                    "variables": [
                        {
                            "name": "ErrorLog",
                            "type": "string",
                            "value": ""
                        }
                    ]
                }
            },
            "Entities_-_Get_Accounts": {
                "runAfter": {
                    "Initialize_ErrorLog": [
                        "Succeeded"
                    ]
                },
                "type": "ApiConnection",
                "inputs": {
                    "host": {
                        "connection": {
                            "name": "@parameters('$connections')['azuresentinel-1']['connectionId']"
                        }
                    },
                    "method": "post",
                    "body": "@triggerBody()?['object']?['properties']?['relatedEntities']",
                    "path": "/entities/account"
                }
            },
            "Condition_-_Accounts_Exist": {
                "actions": {
                    "For_Each_Account": {
                        "foreach": "@body('Entities_-_Get_Accounts')?['Accounts']",
                        "actions": {
                            "Compose_UPN": {
                                "type": "Compose",
                                "inputs": "@toLower(concat(items('For_Each_Account')?['Name'], '@', items('For_Each_Account')?['UPNSuffix']))"
                            },
                            "HTTP_Get_User_Details": {
                                "runAfter": {
                                    "Compose_UPN": [
                                        "Succeeded"
                                    ]
                                },
                                "type": "Http",
                                "inputs": {
                                    "uri": "https://graph.microsoft.com/v1.0/users/@{outputs('Compose_UPN')}?$select=userPrincipalName,id,lastPasswordChangeDateTime,accountEnabled,displayName",
                                    "method": "GET",
                                    "authentication": {
                                        "type": "ManagedServiceIdentity",
                                        "audience": "https://graph.microsoft.com"
                                    },
                                    "retryPolicy": {
                                        "type": "exponential",
                                        "count": 3,
                                        "interval": "PT5S",
                                        "minimumInterval": "PT5S",
                                        "maximumInterval": "PT30S"
                                    }
                                }
                            },
                            "Condition_-_User_Found": {
                                "actions": {
                                    "Compose_AccountStatus": {
                                        "type": "Compose",
                                        "inputs": "@if(equals(body('HTTP_Get_User_Details')?['accountEnabled'], true), 'Enabled', 'Disabled')"
                                    },
                                    "Condition_-_Recent_Password_Change": {
                                        "actions": {
                                            "Append_SummaryTable_RecentReset": {
                                                "type": "AppendToStringVariable",
                                                "inputs": {
                                                    "name": "SummaryTable",
                                                    "value": "<tr><td style=\"padding:8px;border:1px solid #ccc;\">@{outputs('Compose_UPN')}</td><td style=\"padding:8px;border:1px solid #ccc;\">@{outputs('Compose_AccountStatus')}</td><td style=\"padding:8px;border:1px solid #ccc;\"> Skipped</td><td style=\"padding:8px;border:1px solid #ccc;\"> Skipped</td><td style=\"padding:8px;border:1px solid #ccc;\">Password changed in last 30 mins - no action taken</td></tr>"
                                                }
                                            },
                                            "Append_EmailTable_RecentReset": {
                                                "runAfter": {
                                                    "Append_SummaryTable_RecentReset": [
                                                        "Succeeded"
                                                    ]
                                                },
                                                "type": "AppendToStringVariable",
                                                "inputs": {
                                                    "name": "EmailSummaryTable",
                                                    "value": "<tr><td style=\"padding:8px;border:1px solid #ccc;\">@{outputs('Compose_UPN')}</td><td style=\"padding:8px;border:1px solid #ccc;\">@{outputs('Compose_AccountStatus')}</td><td style=\"padding:8px;border:1px solid #ccc;\"> Skipped</td><td style=\"padding:8px;border:1px solid #ccc;\"> Skipped</td><td style=\"padding:8px;border:1px solid #ccc;\">Password changed in last 30 mins - no action taken</td></tr>"
                                                }
                                            }
                                        },
                                        "runAfter": {
                                            "Compose_AccountStatus": [
                                                "Succeeded"
                                            ]
                                        },
                                        "else": {
                                            "actions": {
                                                "Compose_TempPassword": {
                                                    "type": "Compose",
                                                    "inputs": "@concat(toUpper(substring(replace(guid(),'-',''), 0, 3)), toLower(substring(replace(guid(),'-',''), 3, 3)), substring(replace(guid(),'-',''), 6, 2), '!', substring(replace(guid(),'-',''), 8, 2), '@', substring(replace(guid(),'-',''), 10, 2), '#7')"
                                                },
                                                "HTTP_Reset_Password": {
                                                    "runAfter": {
                                                        "Compose_TempPassword": [
                                                            "Succeeded"
                                                        ]
                                                    },
                                                    "type": "Http",
                                                    "inputs": {
                                                        "uri": "https://graph.microsoft.com/v1.0/users/@{outputs('Compose_UPN')}",
                                                        "method": "PATCH",
                                                        "body": {
                                                            "passwordProfile": {
                                                                "forceChangePasswordNextSignIn": true,
                                                                "password": "@{outputs('Compose_TempPassword')}"
                                                            }
                                                        },
                                                        "authentication": {
                                                            "type": "ManagedServiceIdentity",
                                                            "audience": "https://graph.microsoft.com"
                                                        },
                                                        "retryPolicy": {
                                                            "type": "exponential",
                                                            "count": 3,
                                                            "interval": "PT5S",
                                                            "minimumInterval": "PT5S",
                                                            "maximumInterval": "PT30S"
                                                        }
                                                    }
                                                },
                                                "Compose_PwdResetStatus": {
                                                    "runAfter": {
                                                        "HTTP_Reset_Password": [
                                                            "Succeeded",
                                                            "Failed"
                                                        ]
                                                    },
                                                    "type": "Compose",
                                                    "inputs": "@if(equals(outputs('HTTP_Reset_Password')?['statusCode'], 204), ' Reset Success', ' Reset Failed')"
                                                },
                                                "HTTP_Check_MFA_Group_Membership": {
                                                    "runAfter": {
                                                        "Compose_PwdResetStatus": [
                                                            "Succeeded"
                                                        ]
                                                    },
                                                    "type": "Http",
                                                    "inputs": {
                                                        "uri": "https://graph.microsoft.com/v1.0/users/@{body('HTTP_Get_User_Details')?['id']}/checkMemberObjects",
                                                        "method": "POST",
                                                        "body": {
                                                            "ids": [
                                                                "@{parameters('MFAGroupObjectId')}"
                                                            ]
                                                        },
                                                        "authentication": {
                                                            "type": "ManagedServiceIdentity",
                                                            "audience": "https://graph.microsoft.com"
                                                        },
                                                        "retryPolicy": {
                                                            "type": "exponential",
                                                            "count": 3,
                                                            "interval": "PT5S",
                                                            "minimumInterval": "PT5S",
                                                            "maximumInterval": "PT30S"
                                                        }
                                                    }
                                                },
                                                "Condition_-_Is_In_MFA_Group": {
                                                    "actions": {
                                                        "Compose_MFAStatus_AlreadyMember": {
                                                            "type": "Compose",
                                                            "inputs": " Already in MFA Group"
                                                        }
                                                    },
                                                    "runAfter": {
                                                        "HTTP_Check_MFA_Group_Membership": [
                                                            "Succeeded",
                                                            "Failed"
                                                        ]
                                                    },
                                                    "else": {
                                                        "actions": {
                                                            "HTTP_Add_To_MFA_Group": {
                                                                "type": "Http",
                                                                "inputs": {
                                                                    "uri": "https://graph.microsoft.com/v1.0/groups/@{parameters('MFAGroupObjectId')}/members/$ref",
                                                                    "method": "POST",
                                                                    "body": {
                                                                        "@@odata.id": "https://graph.microsoft.com/v1.0/users/@{body('HTTP_Get_User_Details')?['id']}"
                                                                    },
                                                                    "authentication": {
                                                                        "type": "ManagedServiceIdentity",
                                                                        "audience": "https://graph.microsoft.com"
                                                                    },
                                                                    "retryPolicy": {
                                                                        "type": "exponential",
                                                                        "count": 3,
                                                                        "interval": "PT5S",
                                                                        "minimumInterval": "PT5S",
                                                                        "maximumInterval": "PT30S"
                                                                    }
                                                                }
                                                            },
                                                            "Compose_MFAStatus_Added": {
                                                                "runAfter": {
                                                                    "HTTP_Add_To_MFA_Group": [
                                                                        "Succeeded",
                                                                        "Failed"
                                                                    ]
                                                                },
                                                                "type": "Compose",
                                                                "inputs": "@if(equals(outputs('HTTP_Add_To_MFA_Group')?['statusCode'], 204), ' Added to MFA Group', ' MFA Add Failed')"
                                                            }
                                                        }
                                                    },
                                                    "expression": {
                                                        "and": [
                                                            {
                                                                "contains": [
                                                                    "@string(body('HTTP_Check_MFA_Group_Membership')?['value'])",
                                                                    "@parameters('MFAGroupObjectId')"
                                                                ]
                                                            }
                                                        ]
                                                    },
                                                    "type": "If"
                                                },
                                                "Compose_Final_MFA_Status": {
                                                    "runAfter": {
                                                        "Condition_-_Is_In_MFA_Group": [
                                                            "Succeeded"
                                                        ]
                                                    },
                                                    "type": "Compose",
                                                    "inputs": "@if(equals(outputs('HTTP_Check_MFA_Group_Membership')?['statusCode'], 200), coalesce(outputs('Compose_MFAStatus_AlreadyMember'), outputs('Compose_MFAStatus_Added'), ' MFA Check Failed'), ' MFA Check Failed')"
                                                },
                                                "Compose_Notes": {
                                                    "runAfter": {
                                                        "Compose_Final_MFA_Status": [
                                                            "Succeeded"
                                                        ]
                                                    },
                                                    "type": "Compose",
                                                    "inputs": "@if(equals(body('HTTP_Get_User_Details')?['accountEnabled'], false), 'Password reset executed on disabled account', 'Password reset executed')"
                                                },
                                                "Append_SummaryTable_Row": {
                                                    "runAfter": {
                                                        "Compose_Notes": [
                                                            "Succeeded"
                                                        ]
                                                    },
                                                    "type": "AppendToStringVariable",
                                                    "inputs": {
                                                        "name": "SummaryTable",
                                                        "value": "<tr><td style=\"padding:8px;border:1px solid #ccc;\">@{outputs('Compose_UPN')}</td><td style=\"padding:8px;border:1px solid #ccc;\">@{outputs('Compose_AccountStatus')}</td><td style=\"padding:8px;border:1px solid #ccc;\">@{outputs('Compose_PwdResetStatus')}</td><td style=\"padding:8px;border:1px solid #ccc;\">@{outputs('Compose_Final_MFA_Status')}</td><td style=\"padding:8px;border:1px solid #ccc;\">@{outputs('Compose_Notes')}</td></tr>"
                                                    }
                                                },
                                                "Append_EmailTable_Row": {
                                                    "runAfter": {
                                                        "Append_SummaryTable_Row": [
                                                            "Succeeded"
                                                        ]
                                                    },
                                                    "type": "AppendToStringVariable",
                                                    "inputs": {
                                                        "name": "EmailSummaryTable",
                                                        "value": "<tr><td style=\"padding:8px;border:1px solid #ccc;\">@{outputs('Compose_UPN')}</td><td style=\"padding:8px;border:1px solid #ccc;\">@{outputs('Compose_AccountStatus')}</td><td style=\"padding:8px;border:1px solid #ccc;\">@{outputs('Compose_PwdResetStatus')}</td><td style=\"padding:8px;border:1px solid #ccc;\">@{outputs('Compose_Final_MFA_Status')}</td><td style=\"padding:8px;border:1px solid #ccc;\">@{outputs('Compose_Notes')}</td></tr>"
                                                    }
                                                },
                                                "Get_a_row": {
                                                    "runAfter": {
                                                        "Append_EmailTable_Row": [
                                                            "Succeeded"
                                                        ]
                                                    },
                                                    "metadata": {
                                                        "[Excel_File_ID]": "/[ExcelSheet_Name]"
                                                    },
                                                    "type": "ApiConnection",
                                                    "inputs": {
                                                        "host": {
                                                            "connection": {
                                                                "name": "@parameters('$connections')['excelonlinebusiness-1']['connectionId']"
                                                            }
                                                        },
                                                        "method": "get",
                                                        "path": "/drives/@{encodeURIComponent('[Drive_ID]')}/files/@{encodeURIComponent(encodeURIComponent('[Excel_File_ID]'))}/tables/@{encodeURIComponent('{[Excel_Table_ID]}')}/items/@{encodeURIComponent(encodeURIComponent(outputs('Compose_UPN')))}",
                                                        "queries": {
                                                            "source": "me",
                                                            "idColumn": "UPN"
                                                        }
                                                    }
                                                },
                                                "Condition": {
                                                    "actions": {
                                                        "Update_a_row": {
                                                            "metadata": {
                                                                "[Excel_File_ID]": "/[ExcelSheet_Name]"
                                                            },
                                                            "type": "ApiConnection",
                                                            "inputs": {
                                                                "host": {
                                                                    "connection": {
                                                                        "name": "@parameters('$connections')['excelonlinebusiness-1']['connectionId']"
                                                                    }
                                                                },
                                                                "method": "patch",
                                                                "body": {
                                                                    "Incident Number": "@{triggerBody()?['object']?['properties']?['incidentNumber']}",
                                                                    "MFA Group Status": "@{outputs('Compose_Final_MFA_Status')}",
                                                                    "Notes": "@{outputs('Compose_Notes')}",
                                                                    "Last Password Reset Time": "@formatDateTime(convertTimeZone(utcNow(),'UTC','Arab Standard Time'),'yyyy-MM-dd HH:mm:ss')"
                                                                },
                                                                "path": "/drives/@{encodeURIComponent('[Drive_ID]')}/files/@{encodeURIComponent(encodeURIComponent('[Excel_File_ID]'))}/tables/@{encodeURIComponent('{[Excel_Table_ID]}')}/items/@{encodeURIComponent(encodeURIComponent(outputs('Compose_UPN')))}",
                                                                "queries": {
                                                                    "source": "me",
                                                                    "idColumn": "UPN"
                                                                }
                                                            }
                                                        }
                                                    },
                                                    "runAfter": {
                                                        "Get_a_row": [
                                                            "Succeeded",
                                                            "TimedOut",
                                                            "Failed"
                                                        ]
                                                    },
                                                    "else": {
                                                        "actions": {
                                                            "Add_a_row_into_a_table": {
                                                                "metadata": {
                                                                    "[Excel_File_ID]": "/[ExcelSheet_Name]"
                                                                },
                                                                "type": "ApiConnection",
                                                                "inputs": {
                                                                    "host": {
                                                                        "connection": {
                                                                            "name": "@parameters('$connections')['excelonlinebusiness-1']['connectionId']"
                                                                        }
                                                                    },
                                                                    "method": "post",
                                                                    "body": {
                                                                        "UPN": "@{outputs('Compose_UPN')}",
                                                                        "Incident Number": "@{triggerBody()?['object']?['properties']?['incidentNumber']}",
                                                                        "MFA Group Status": "@{outputs('Compose_Final_MFA_Status')}",
                                                                        "Notes": "@{outputs('Compose_Notes')}",
                                                                        "Last Password Reset Time": "@formatDateTime(convertTimeZone(utcNow(),'UTC','Arab Standard Time'),'yyyy-MM-dd HH:mm:ss')"
                                                                    },
                                                                    "path": "/codeless/v1.2/drives/@{encodeURIComponent('[Drive_ID]')}/items/@{encodeURIComponent(encodeURIComponent('[Excel_File_ID]'))}/workbook/tables/@{encodeURIComponent('{[Excel_Table_ID]}')}/rows",
                                                                    "queries": {
                                                                        "source": "me"
                                                                    }
                                                                }
                                                            }
                                                        }
                                                    },
                                                    "expression": {
                                                        "and": [
                                                            {
                                                                "equals": [
                                                                    "@outputs('Get_a_row')?['statusCode']",
                                                                    200
                                                                ]
                                                            }
                                                        ]
                                                    },
                                                    "type": "If"
                                                }
                                            }
                                        },
                                        "expression": {
                                            "and": [
                                                {
                                                    "greaterOrEquals": [
                                                        "@ticks(body('HTTP_Get_User_Details')?['lastPasswordChangeDateTime'])",
                                                        "@ticks(addMinutes(utcNow(), -1))"
                                                    ]
                                                }
                                            ]
                                        },
                                        "type": "If"
                                    }
                                },
                                "runAfter": {
                                    "HTTP_Get_User_Details": [
                                        "Succeeded",
                                        "Failed"
                                    ]
                                },
                                "else": {
                                    "actions": {
                                        "Append_SummaryTable_UserNotFound": {
                                            "type": "AppendToStringVariable",
                                            "inputs": {
                                                "name": "SummaryTable",
                                                "value": "<tr><td style=\"padding:8px;border:1px solid #ccc;\">@{outputs('Compose_UPN')}</td><td style=\"padding:8px;border:1px solid #ccc;\">Not Found</td><td style=\"padding:8px;border:1px solid #ccc;\"> Skipped</td><td style=\"padding:8px;border:1px solid #ccc;\"> Skipped</td><td style=\"padding:8px;border:1px solid #ccc;\">User not found in Entra ID (HTTP @{outputs('HTTP_Get_User_Details')?['statusCode']})</td></tr>"
                                            }
                                        },
                                        "Append_EmailTable_UserNotFound": {
                                            "runAfter": {
                                                "Append_SummaryTable_UserNotFound": [
                                                    "Succeeded"
                                                ]
                                            },
                                            "type": "AppendToStringVariable",
                                            "inputs": {
                                                "name": "EmailSummaryTable",
                                                "value": "<tr><td style=\"padding:8px;border:1px solid #ccc;\">@{outputs('Compose_UPN')}</td><td style=\"padding:8px;border:1px solid #ccc;\">Not Found</td><td style=\"padding:8px;border:1px solid #ccc;\"> Skipped</td><td style=\"padding:8px;border:1px solid #ccc;\"> Skipped</td><td style=\"padding:8px;border:1px solid #ccc;\">User not found in Entra ID (HTTP @{outputs('HTTP_Get_User_Details')?['statusCode']})</td></tr>"
                                            }
                                        },
                                        "Append_ErrorLog_UserNotFound": {
                                            "runAfter": {
                                                "Append_EmailTable_UserNotFound": [
                                                    "Succeeded"
                                                ]
                                            },
                                            "type": "AppendToStringVariable",
                                            "inputs": {
                                                "name": "ErrorLog",
                                                "value": " User @{outputs('Compose_UPN')} not found in Entra ID. HTTP Status: @{outputs('HTTP_Get_User_Details')?['statusCode']}\n"
                                            }
                                        }
                                    }
                                },
                                "expression": {
                                    "and": [
                                        {
                                            "equals": [
                                                "@outputs('HTTP_Get_User_Details')?['statusCode']",
                                                200
                                            ]
                                        }
                                    ]
                                },
                                "type": "If"
                            }
                        },
                        "type": "Foreach",
                        "runtimeConfiguration": {
                            "concurrency": {
                                "repetitions": 1
                            }
                        }
                    }
                },
                "runAfter": {
                    "Entities_-_Get_Accounts": [
                        "Succeeded"
                    ]
                },
                "else": {
                    "actions": {
                        "Append_SummaryTable_NoAccounts": {
                            "type": "AppendToStringVariable",
                            "inputs": {
                                "name": "SummaryTable",
                                "value": "<tr><td colspan=\"5\" style=\"padding:8px;border:1px solid #ccc;text-align:center;\"> No Account entities found in this incident.</td></tr>"
                            }
                        },
                        "Append_EmailTable_NoAccounts": {
                            "runAfter": {
                                "Append_SummaryTable_NoAccounts": [
                                    "Succeeded"
                                ]
                            },
                            "type": "AppendToStringVariable",
                            "inputs": {
                                "name": "EmailSummaryTable",
                                "value": "<tr><td colspan=\"5\" style=\"padding:8px;border:1px solid #ccc;text-align:center;\"> No Account entities found in this incident.</td></tr>"
                            }
                        }
                    }
                },
                "expression": {
                    "and": [
                        {
                            "greater": [
                                "@length(body('Entities_-_Get_Accounts')?['Accounts'])",
                                0
                            ]
                        }
                    ]
                },
                "type": "If"
            },
            "Add_Comment_to_Sentinel_Incident": {
                "runAfter": {
                    "Condition_-_Accounts_Exist": [
                        "Succeeded",
                        "Failed",
                        "Skipped",
                        "TimedOut"
                    ]
                },
                "type": "ApiConnection",
                "inputs": {
                    "host": {
                        "connection": {
                            "name": "@parameters('$connections')['azuresentinel-2']['connectionId']"
                        }
                    },
                    "method": "post",
                    "body": {
                        "incidentArmId": "@triggerBody()?['object']?['id']",
                        "message": "<p><strong>Password Reset Playbook - Execution Summary</strong></p><p><strong>Incident:</strong> @{triggerBody()?['object']?['properties']?['incidentNumber']}</p><p><strong>Executed On (Local Time):</strong> @{formatDateTime(convertTimeZone(utcNow(),'UTC','Arabian Standard Time'),'yyyy-MM-dd HH:mm:ss')}</p><p><strong>Total Accounts Processed:</strong> @{length(body('Entities_-_Get_Accounts')?['Accounts'])}</p><p><strong>Action Summary:</strong></p><table border=\"1\" style=\"border-collapse:collapse;width:100%;font-family:Arial,sans-serif;font-size:13px;\"><thead>@{variables('SummaryTable')}</thead><tbody></tbody></table>@{if(not(equals(variables('ErrorLog'), '')), concat('<p><strong>Errors / Warnings:</strong><br/><pre>', variables('ErrorLog'), '</pre></p>'), '')}"
                    },
                    "path": "/Incidents/Comment"
                }
            },
            "Send_Alert_Email": {
                "runAfter": {
                    "Add_Comment_to_Sentinel_Incident": [
                        "Succeeded"
                    ]
                },
                "type": "ApiConnection",
                "inputs": {
                    "host": {
                        "connection": {
                            "name": "@parameters('$connections')['office365']['connectionId']"
                        }
                    },
                    "method": "post",
                    "body": {
                        "To": "@parameters('AlertEmailRecipient')",
                        "Subject": " Password Reset Executed - Incident @{triggerBody()?['object']?['properties']?['incidentNumber']}",
